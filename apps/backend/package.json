{
  "name": "@rafimdan/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply rafimdan-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rafimdan-db --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@rafimdan/shared": "workspace:*",
    "hono": "^4.12.14",
    "jose": "^6.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@vitest/runner": "~3.2.4",
    "@vitest/snapshot": "~3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^3.99.0"
  }
}
